<!-- 
    This file serves as the main entry point for the website.
    It defines the structure and content of the homepage using HTML.
    The <!DOCTYPE html> declaration specifies the document type and version (HTML5).
-->
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>tweakerzinthechat</title>
    <style>
        :root{font-family:system-ui,-apple-system,Segoe UI,Roboto,Ubuntu,'Helvetica Neue',Arial}
        body{margin:0;line-height:1.4;padding:20px;background:#f6f7fb;color:#111}
        header{display:flex;align-items:center;justify-content:space-between;gap:16px}
        nav a{margin-right:12px;color:#0366d6;text-decoration:none}
        nav a:hover{text-decoration:underline}
        main{max-width:960px;margin-top:18px}
        section{background:#fff;padding:16px;border-radius:8px;box-shadow:0 1px 3px rgba(16,24,40,.04);margin-bottom:16px}
        .games-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:12px}
        .ttt-board{display:grid;grid-template-columns:repeat(3,1fr);gap:6px}
        .cell{background:#eef2ff;border-radius:6px;min-height:64px;display:flex;align-items:center;justify-content:center;font-size:28px;cursor:pointer}
        .controls{margin-top:8px;display:flex;gap:8px;align-items:center}
        .rps-buttons button{margin-right:8px}
        .small{font-size:14px;color:#555}
        /* Access overlay */
        .access-overlay{position:fixed;inset:0;display:flex;align-items:center;justify-content:center;background:rgba(2,6,23,0.6);z-index:9999}
        .access-box{background:#fff;padding:20px;border-radius:10px;max-width:420px;width:92%;box-shadow:0 8px 24px rgba(2,6,23,.4)}
        .access-box h2{margin-top:0}
        .access-row{display:flex;gap:8px;margin-top:8px}
        .access-row input{flex:1;padding:8px;border-radius:6px;border:1px solid #ddd}
        .access-actions{display:flex;gap:8px;justify-content:flex-end;margin-top:12px}
        #manage-access{color:#0366d6;text-decoration:none}
        #manage-access:hover{text-decoration:underline}
    </style>
</head>
<body>
    <header>
        <div>
            <h1 style="margin:0">Tweakerzinthechat</h1>
            <p class="small" style="margin:4px 0 0">Welcome Tweakerz to the chat! This is the find page.</p>
        </div>
        <nav aria-label="Main navigation">
            <a href="#games">Games</a>
            <div id="access-manage" style="display:none">
                <p class="small">Manage your access code. You can remove the code to make the site public again.</p>
                <div class="access-actions">
                    <button id="access-remove">Remove code</button>
                    <button id="access-close">Close</button>
                </div>
                <p id="access-manage-msg" class="small" aria-live="polite"></p>
            </div>

            <p id="access-setup-msg" class="small" aria-live="polite" style="display:none"></p>
        </div>
    </div>

    <section id="games">
        <h2>Games</h2>
        <div class="games-grid">
            <!-- (existing game articles are assumed to be above) -->
        </div>
    </section>

    <script>
        // Consolidated scripts: games + access control

        // Tic-Tac-Toe
        (function(){
            const cells = Array.from(document.querySelectorAll('.cell'));
            const resetBtn = document.getElementById('ttt-reset');
            const playerEl = document.getElementById('ttt-player');
            const statusEl = document.getElementById('ttt-status');
            if(cells.length){
                let board = Array(9).fill('');
                let current = 'X';
                const wins = [[0,1,2],[3,4,5],[6,7,8],[0,3,6],[1,4,7],[2,5,8],[0,4,8],[2,4,6]];
                function checkWin(b){ for(const w of wins){ const [a,b1,c]=w; if(b[a] && b[a]===b[b1] && b[a]===b[c]) return b[a]; } return null; }
                function update(){ cells.forEach((cell,i)=> cell.textContent = board[i]); if(playerEl) playerEl.textContent = current; const winner = checkWin(board); if(winner){ if(statusEl) statusEl.textContent = `Winner: ${winner}`; cells.forEach(c=>c.style.pointerEvents='none'); } else if(board.every(Boolean)){ if(statusEl) statusEl.textContent = 'Draw'; } else { if(statusEl) statusEl.textContent = `Current: ${current}`; } }
                function makeMove(i){ if(board[i] || checkWin(board)) return; board[i]=current; current = current === 'X' ? 'O' : 'X'; update(); }
                cells.forEach((cell,i)=>{ cell.addEventListener('click', ()=> makeMove(i)); cell.addEventListener('keydown', (e)=>{ if(e.key === 'Enter' || e.key === ' ') { e.preventDefault(); makeMove(i); } }); });
                if(resetBtn) resetBtn.addEventListener('click', ()=>{ board = Array(9).fill(''); current='X'; cells.forEach(c=>c.style.pointerEvents='auto'); update(); });
                update();
            }
        })();

        // Rock Paper Scissors
        (function(){
            const buttons = Array.from(document.querySelectorAll('[data-move]'));
            const you = document.getElementById('rps-you');
            const cpu = document.getElementById('rps-cpu');
            const result = document.getElementById('rps-result');
            const reset = document.getElementById('rps-reset');
            if(buttons.length){
                let scoreYou = 0, scoreCpu = 0;
                const beats = { rock: 'scissors', paper: 'rock', scissors: 'paper' };
                function cpuChoice(){ return ['rock','paper','scissors'][Math.floor(Math.random()*3)]; }
                buttons.forEach(btn=> btn.addEventListener('click', ()=>{ const move = btn.dataset.move; const c = cpuChoice(); if(move === c){ if(result) result.textContent = `Tie — both chose ${move}`; } else if(beats[move] === c){ scoreYou++; if(result) result.textContent = `You win — ${move} beats ${c}`; } else { scoreCpu++; if(result) result.textContent = `CPU wins — ${c} beats ${move}`; } if(you) you.textContent = scoreYou; if(cpu) cpu.textContent = scoreCpu; }));
                if(reset) reset.addEventListener('click', ()=>{ scoreYou=0; scoreCpu=0; if(you) you.textContent='0'; if(cpu) cpu.textContent='0'; if(result) result.textContent=''; });
            }
        })();

        // Retro Bowl (mini)
        (function(){
            const downEl = document.getElementById('rb-down');
            const distEl = document.getElementById('rb-distance');
            const yardEl = document.getElementById('rb-yard');
            const log = document.getElementById('rb-log');
            const scoreEl = document.getElementById('rb-score');
            const runBtn = document.getElementById('rb-run');
            const passBtn = document.getElementById('rb-pass');
            const resetBtn = document.getElementById('rb-reset');
            if(downEl){
                let down = 1, distance = 10, yard = 20, score = 0;
                function render(){ downEl.textContent = down; distEl.textContent = distance; yardEl.textContent = yard; scoreEl.textContent = score; }
                function play(type){ const runYards = Math.max(-3, Math.floor(Math.random()*11) - 3); const passYards = Math.max(-5, Math.floor(Math.random()*31) - 5); const yards = type === 'run' ? runYards : passYards; yard += yards; distance -= yards; let msg = `${type.toUpperCase()} for ${yards} yards.`; if(yard >= 100){ score += 7; msg += ' TOUCHDOWN!'; yard = 20; distance = 10; down = 1; } else { if(distance <= 0){ down = 1; distance = 10; msg += ' First down!'; } else { down += 1; if(down > 4){ msg += ' Turnover on downs.'; yard = 20; distance = 10; down = 1; } } } if(log) log.textContent = msg; render(); }
                if(runBtn) runBtn.addEventListener('click', ()=> play('run'));
                if(passBtn) passBtn.addEventListener('click', ()=> play('pass'));
                if(resetBtn) resetBtn.addEventListener('click', ()=>{ down=1; distance=10; yard=20; score=0; if(log) log.textContent=''; render(); });
                render();
            }
        })();

        // Tiny top-down shooter
        (function(){
            const canvas = document.getElementById('fn-canvas');
            if(canvas){
                const ctx = canvas.getContext('2d');
                const scoreEl = document.getElementById('fn-score');
                const resetBtn = document.getElementById('fn-reset');
                let w = canvas.width, h = canvas.height;
                let keys = {};
                let player = { x: w/2, y: h-40, w: 18, h: 18, speed: 2 };
                let bullets = [];
                let enemies = [];
                let score = 0;
                let spawnTimer = 0;
                function spawnEnemy(){ enemies.push({ x: Math.random()*(w-20)+10, y: -10, w:14, h:14, speed: 0.6 + Math.random()*1.2 }); }
                function update(){ if(keys.ArrowLeft) player.x -= player.speed; if(keys.ArrowRight) player.x += player.speed; if(keys.ArrowUp) player.y -= player.speed; if(keys.ArrowDown) player.y += player.speed; player.x = Math.max(8, Math.min(w-8, player.x)); player.y = Math.max(8, Math.min(h-8, player.y)); bullets.forEach(b=> b.y -= 4); bullets = bullets.filter(b=> b.y > -10); enemies.forEach(e=> e.y += e.speed); enemies = enemies.filter(e=> e.y < h+20); for(let i=enemies.length-1;i>=0;i--){ const e = enemies[i]; for(let j=bullets.length-1;j>=0;j--){ const b = bullets[j]; if(b.x > e.x-8 && b.x < e.x+8 && b.y > e.y-8 && b.y < e.y+8){ enemies.splice(i,1); bullets.splice(j,1); score += 1; if(scoreEl) scoreEl.textContent = score; break; } } } spawnTimer += 1; if(spawnTimer > 60){ spawnTimer = 0; spawnEnemy(); } }
                function draw(){ ctx.clearRect(0,0,w,h); ctx.fillStyle = '#4ade80'; ctx.fillRect(player.x-player.w/2, player.y-player.h/2, player.w, player.h); ctx.fillStyle = '#fef08a'; bullets.forEach(b=> ctx.fillRect(b.x-2,b.y-6,4,8)); ctx.fillStyle = '#fb7185'; enemies.forEach(e=> ctx.fillRect(e.x-e.w/2,e.y-e.h/2,e.w,e.h)); }
                function loop(){ update(); draw(); requestAnimationFrame(loop); }
                window.addEventListener('keydown', e=>{ keys[e.key]=true; if(e.key === ' ') { bullets.push({ x: player.x, y: player.y-12 }); } });
                window.addEventListener('keyup', e=>{ keys[e.key]=false; });
                if(resetBtn) resetBtn.addEventListener('click', ()=>{ bullets=[]; enemies=[]; score=0; if(scoreEl) scoreEl.textContent=score; player.x=w/2; player.y=h-40; });
                requestAnimationFrame(loop);
            }
        })();

        // Access control
        (async function(){
            const STORAGE_KEY = 'site_access_hash';
            const LAST_KEY = 'site_last_unlock_ts';
            const SESSION_KEY = 'site_unlocked';
            const SWITCH_KEY = 'site_tab_switches';
            const TTL = 12 * 60 * 60 * 1000;
            const SWITCH_LIMIT = 12;
            const manageLink = document.getElementById('manage-access');
            const overlay = document.getElementById('access-overlay');
            const setup = document.getElementById('access-setup');
            const enter = document.getElementById('access-enter');
            const manage = document.getElementById('access-manage');
            const newCode = document.getElementById('new-code');
            const confirmCode = document.getElementById('confirm-code');
            const createBtn = document.getElementById('access-create');
            const setupMsg = document.getElementById('access-setup-msg');
            const enterCode = document.getElementById('enter-code');
            const submitBtn = document.getElementById('access-submit');
            const enterMsg = document.getElementById('access-enter-msg');
            const removeBtn = document.getElementById('access-remove');
            const closeBtn = document.getElementById('access-close');
            const manageMsg = document.getElementById('access-manage-msg');
            async function sha256(str){ const buf = await crypto.subtle.digest('SHA-256', new TextEncoder().encode(str)); return Array.from(new Uint8Array(buf)).map(b=>b.toString(16).padStart(2,'0')).join(''); }
            function showOverlay(mode){ if(!overlay) return; overlay.style.display='flex'; overlay.setAttribute('aria-hidden','false'); if(setup) setup.style.display='none'; if(enter) enter.style.display='none'; if(manage) manage.style.display='none'; if(setupMsg) setupMsg.textContent=''; if(enterMsg) enterMsg.textContent=''; if(manageMsg) manageMsg.textContent=''; if(mode==='setup' && setup) setup.style.display=''; else if(mode==='enter' && enter) enter.style.display=''; else if(mode==='manage' && manage) manage.style.display=''; setTimeout(()=>{ const input = overlay.querySelector('input'); if(input) input.focus(); },80); }
            function hideOverlay(){ if(!overlay) return; overlay.style.display='none'; overlay.setAttribute('aria-hidden','true'); }
            function getSwitchCount(){ return Number(sessionStorage.getItem(SWITCH_KEY) || 0); }
            function resetSwitchCount(){ sessionStorage.setItem(SWITCH_KEY,'0'); }
            function incrementSwitchCount(){ const n = getSwitchCount()+1; sessionStorage.setItem(SWITCH_KEY,String(n)); if(n>=SWITCH_LIMIT){ sessionStorage.removeItem(SESSION_KEY); localStorage.removeItem(LAST_KEY); resetSwitchCount(); showOverlay('enter'); } }
            function isSessionUnlocked(){ return !!sessionStorage.getItem(SESSION_KEY); }
            function isWithinTTL(){ const ts=Number(localStorage.getItem(LAST_KEY)||0); if(!ts) return false; return (Date.now()-ts)<=TTL; }
            async function ensureDefaultCode(){ if(!localStorage.getItem(STORAGE_KEY)){ const h = await sha256('micepad'); localStorage.setItem(STORAGE_KEY,h); } }
            async function checkAndEnforce(){ await ensureDefaultCode(); const stored = localStorage.getItem(STORAGE_KEY); if(!stored && manageLink) manageLink.style.display='none'; if(manageLink) manageLink.style.display=''; if(isSessionUnlocked() && isWithinTTL()){ hideOverlay(); return; } showOverlay('enter'); }
            document.addEventListener('visibilitychange', ()=>{ if(document.hidden) incrementSwitchCount(); });
            if(createBtn) createBtn.addEventListener('click', async ()=>{ const a=(newCode.value||'').trim(); const b=(confirmCode.value||'').trim(); if(!a||!b){ if(setupMsg) setupMsg.textContent='Please enter and confirm a code.'; return; } if(a!==b){ if(setupMsg) setupMsg.textContent='Codes do not match.'; return; } const h=await sha256(a); localStorage.setItem(STORAGE_KEY,h); localStorage.setItem(LAST_KEY,String(Date.now())); sessionStorage.setItem(SESSION_KEY,'1'); if(setupMsg) setupMsg.textContent='Access code saved and unlocked for this session.'; if(newCode) newCode.value=''; if(confirmCode) confirmCode.value=''; if(manageLink) manageLink.style.display=''; hideOverlay(); });
            if(submitBtn) submitBtn.addEventListener('click', async ()=>{ const provided=(enterCode.value||'').trim(); const stored=localStorage.getItem(STORAGE_KEY); if(!stored){ if(enterMsg) enterMsg.textContent='No access code is set.'; return; } const h=await sha256(provided); if(h===stored){ sessionStorage.setItem(SESSION_KEY,'1'); localStorage.setItem(LAST_KEY,String(Date.now())); resetSwitchCount(); if(enterMsg) enterMsg.textContent='Access granted.'; if(enterCode) enterCode.value=''; hideOverlay(); } else { if(enterMsg) enterMsg.textContent='Incorrect code.'; } });
            if(removeBtn) removeBtn.addEventListener('click', ()=>{ localStorage.removeItem(STORAGE_KEY); localStorage.removeItem(LAST_KEY); sessionStorage.removeItem(SESSION_KEY); if(manageMsg) manageMsg.textContent='Access code removed; site is now public.'; if(manageLink) manageLink.style.display='none'; hideOverlay(); });
            if(closeBtn) closeBtn.addEventListener('click', ()=>{ hideOverlay(); });
            if(manageLink) manageLink.addEventListener('click', (e)=>{ e.preventDefault(); showOverlay('manage'); });
            checkAndEnforce();
        })();
    </script>
</body>
</html>
